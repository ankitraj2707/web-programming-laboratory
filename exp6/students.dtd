
<?xml version="1.0" encoding="UTF-8"?>

<!ELEMENT students (student+)>

<!ELEMENT student (name, course, semester, marks)>

<!ATTLIST student
    enrollment ID #REQUIRED
>

<!ELEMENT name (#PCDATA)>
<!ELEMENT course (#PCDATA)>
<!ELEMENT semester (#PCDATA)>

<!ELEMENT marks (subject, subject, subject, subject, subject)>

<!ELEMENT subject (#PCDATA)>

<!ATTLIST subject
    name CDATA #REQUIRED
>
