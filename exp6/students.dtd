<!ELEMENT students (student, student, student, student, student, student*)>
<!ATTLIST students
    xmlns:xsi CDATA #IMPLIED
    xsi:noNamespaceSchemaLocation CDATA #IMPLIED>

<!ELEMENT student (name, course, semester, marks)>
<!ATTLIST student
    enrollmentNo ID #REQUIRED>

<!ELEMENT name (#PCDATA)>
<!ELEMENT course (#PCDATA)>
<!ELEMENT semester (#PCDATA)>

<!ELEMENT marks (subject, subject, subject, subject, subject)>
<!ELEMENT subject (#PCDATA)>
<!ATTLIST subject
    code CDATA #REQUIRED
    name CDATA #REQUIRED>